          ^^^^ type[declaration]



        typedef union tagged {

            struct {

                bit [4:0] reg1, reg2, regd;

            } Add;
              ^^^ property[declaration]

            union tagged {

                bit [9:0] JmpU;

                struct {

                    bit [1:0] cc;

                    bit [9:0] addr;

