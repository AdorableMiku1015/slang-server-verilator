                                         ^ property[declaration]
                                             ^^ variable
                                                  ^^ variable
                                                       ^ property

                            tagged JmpC '{.c, .a} : if (rf[c]) pc = a;
                                           ^ property[declaration]
                                               ^ property[declaration]
                                                        ^^ variable
                                                           ^ property
                                                               ^^ variable
                                                                    ^ property

                           endcase

        endcase



        if (instr matches (tagged Jmp .j) &&&
            ^^^^^ variable
                                       ^ property[declaration]

            j matches (tagged JmpC '{cc:.c,addr:.a})) begin
            ^ property
                                         ^ property[declaration]
                                                 ^ property[declaration]

            pc = c[0] & a[0];
            ^^ variable
                 ^ property
                        ^ property

