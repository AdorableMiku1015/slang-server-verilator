checker assert_window1 (
        ^^^^^^^^^^^^^^ instance[declaration]

    logic test_expr,
          ^^^^^^^^^ port[declaration]

    untyped start_event,
            ^^^^^^^^^^^ port[declaration]

    untyped end_event,
            ^^^^^^^^^ port[declaration]

    event clock = $inferred_clock,
          ^^^^^ port[declaration]
                  ^^^^^^^^^^^^^^^ function[defaultLibrary]

    logic reset = $inferred_disable,
          ^^^^^ port[declaration]
                  ^^^^^^^^^^^^^^^^^ function[defaultLibrary]

    string error_msg = "violation",
           ^^^^^^^^^ port[declaration]

    coverage_level clevel = cover_all
    ^^^^^^^^^^^^^^ type
                   ^^^^^^ port[declaration]
                            ^^^^^^^^^ enumMember

);

    default clocking @clock; endclocking
                      ^^^^^ port

    default disable iff reset;
                        ^^^^^ port

    bit window = 1'b0, next_window = 1'b1;
        ^^^^^^ variable[declaration]
                       ^^^^^^^^^^^ variable[declaration]

    rand bit q;
             ^ variable[declaration]



    always_comb begin

        if (reset || window && end_event)
            ^^^^^ port
                     ^^^^^^ variable
                               ^^^^^^^^^ port

            next_window = 1'b0;
            ^^^^^^^^^^^ variable

        else if (!window && start_event)
                  ^^^^^^ variable
                            ^^^^^^^^^^^ port

            next_window = 1'b1;
            ^^^^^^^^^^^ variable

        else

            next_window = window;
            ^^^^^^^^^^^ variable
                          ^^^^^^ variable

    end



    always_ff @clock
               ^^^^^ port

        window <= next_window;
        ^^^^^^ variable
                  ^^^^^^^^^^^ variable



    property p_window;
             ^^^^^^^^ function[declaration]

        start_event && !window |=> test_expr[+] ##0 end_event;
        ^^^^^^^^^^^ port
                        ^^^^^^ variable
                                   ^^^^^^^^^ port
                                                    ^^^^^^^^^ port

    endproperty



    a_window: assert property (p_window) else $error(error_msg);
                               ^^^^^^^^ function
                                              ^^^^^^ function[defaultLibrary]
                                                     ^^^^^^^^^ port



    generate if (clevel != cover_none) begin : cover_b
                 ^^^^^^ port
                           ^^^^^^^^^^ enumMember
                                               ^^^^^^^ label

        cover_window_open: cover property (start_event && !window)
                                           ^^^^^^^^^^^ port
                                                           ^^^^^^ variable

        $display("window_open covered");
        ^^^^^^^^ function[defaultLibrary]

        cover_window: cover property (

            start_event && !window
            ^^^^^^^^^^^ port
                            ^^^^^^ variable

            ##1 (!end_event && window) [*]
                  ^^^^^^^^^ port
                               ^^^^^^ variable

            ##1 end_event && window
                ^^^^^^^^^ port
                             ^^^^^^ variable

        ) $display("window covered");
          ^^^^^^^^ function[defaultLibrary]

    end : cover_b
          ^^^^^^^ label

    endgenerate

endchecker : assert_window1
             ^^^^^^^^^^^^^^ instance



