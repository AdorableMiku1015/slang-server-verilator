    rand bit [63:0] value;
                    ^^^^^ property[declaration]

    rand logic q;
               ^ property[declaration]

    constraint value_c {
               ^^^^^^^ property[declaration]

        value[63] dist {0 :/ 70, 1 :/ 30};
        ^^^^^ property

        value[0] == 1'b0;
        ^^^^^ property

        value[15:8] inside {
        ^^^^^ property

            8'h0,

            8'hF

        };

        solve value before q;
              ^^^^^ property
                           ^ property

        soft value[3:1] > 1;
             ^^^^^ property

        q -> { value[4] == 0; }
        ^ property
               ^^^^^ property

        if (q) { foreach (value[b]) { value[b] == 0; } } else { disable soft value; }
            ^ property
                          ^^^^^ property
                                      ^^^^^ property
                                                                             ^^^^^ property

    }

