module ALU (o1, i1, i2, opcode);
       ^^^ class[declaration,definition]
            ^^ port
                ^^ port
                    ^^ port
                        ^^^^^^ port

    input [7:0] i1, i2;
                ^^ net[declaration]
                    ^^ net[declaration]

    input [2:1] opcode;
                ^^^^^^ net[declaration]

    output [7:0] o1;
                 ^^ net[declaration]



    specify

        specparam s1 = 2;
                  ^^ parameter[declaration]

        if (opcode == 2'b00) (i1,i2 *> o1) = (25.0, 25.0);
            ^^^^^^ net
                              ^^ net
                                 ^^ net
                                       ^^ net

        if (opcode == 2'b01) (i1 => o1) = (5.6, 8.0);
            ^^^^^^ net
                              ^^ net
                                    ^^ net

        if (opcode == s1) (i2 => o1) = (5.6, 8.0);
            ^^^^^^ net
                      ^^ parameter
                           ^^ net
                                 ^^ net

        (opcode *> o1) = (6.1, 6.5);
         ^^^^^^ net
                   ^^ net

    endspecify

endmodule



