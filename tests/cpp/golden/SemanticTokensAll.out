        AxC: cross color, pixel_adr;

        all: cross color, Hue, Offset;



        option.comment = instComment;
                         ^^^^^^^^^^^ parameter



        e: coverpoint x iff (clk) {
                      ^ property
                             ^^^ property

            option.weight = 2;
            ^^^^^^ property
                   ^^^^^^ property

            wildcard bins a = { [0:63],65 };

            bins b[] = { [127:150],[148:191] }; // note overlapping values

            bins c[] = { 200,201,202 };

            bins d = { [1000:$] };

            bins others[] = default;



            bins sa = (4 => 5 => 6), ([7:9],10 => 11,12);

            bins sb[] = (12 => 3 [* 1]);

            bins sc = (12 => 3 [-> 1]);

            bins sd = (12 => 3 [= 1:2]);

        }

        cross e, y {

            option.weight = c;
            ^^^^^^ property
                   ^^^^^^ property
                            ^ property

            bins one = '{ '{1,2}, '{3,4}, '{5,6} };

            ignore_bins others = (!binsof(e.a) || !binsof(y) intersect {1}) with (e > 10);

        }

        b: cross y, x;

    endgroup

endclass



module m9;
       ^^ class[declaration,definition]

    logic [3:0] a = {4 {1'b1}};
                ^ variable[declaration]

endmodule



module m10;
       ^^^ class[declaration,definition]

    byte stream[$];
         ^^^^^^ variable[declaration]

    class Packet;
          ^^^^^^ class[declaration]

        rand int header;
                 ^^^^^^ property[declaration]

        rand int len;
                 ^^^ property[declaration]

        rand byte payload[];
                  ^^^^^^^ property[declaration]

        int crc;
            ^^^ property[declaration]

        constraint G { len > 1; payload.size == len ; }
                   ^ property[declaration]
                       ^^^ property
                                ^^^^^^^ property
                                                ^^^ property

        function void post_randomize; crc = payload.sum; endfunction
                      ^^^^^^^^^^^^^^ function[declaration]
                                      ^^^ property
                                            ^^^^^^^ property

    endclass



    initial begin

        byte q[$];
             ^ variable[declaration]

        automatic Packet p = new;
                  ^^^^^^ class
                         ^ variable[declaration]

        {<< byte{ p.header, p.len, p.payload with [0 +: p.len], p.crc }} = stream;
                  ^ variable
                    ^^^^^^ property
                            ^ variable
                              ^^^ property
                                   ^ variable
                                     ^^^^^^^ property
                                                        ^ variable
                                                          ^^^ property
                                                                ^ variable
                                                                  ^^^ property
                                                                           ^^^^^^ variable

        stream = stream[ $bits(p) / 8 : $ ];
        ^^^^^^ variable
                 ^^^^^^ variable
                         ^^^^^ function[defaultLibrary]
                               ^ variable

    end

endmodule
