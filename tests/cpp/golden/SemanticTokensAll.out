module m6;
       ^^ class[declaration,definition]

    A a = new;
    ^ class
      ^ variable[declaration]

    A b1 = B::new;
    ^ class
      ^^ variable[declaration]
           ^ class

    B b2 = new;
    ^ class
      ^^ variable[declaration]

    C2 c = new;
    ^^ class
       ^ variable[declaration]

    int depth;
        ^^^^^ variable[declaration]

    integer i = b1.f();
            ^ variable[declaration]
                ^^ variable
                   ^ function

    initial begin

        b2.f();
        ^^ variable
           ^ function

        a = b2;
        ^ variable
            ^^ variable

        c.i = c.j;
        ^ variable
          ^ property
              ^ variable
                ^ property



        randsequence(main)

            main : first second;

            first : add | dec := (1 + 1);

            second : repeat($urandom_range(2, 6)) first;
                            ^^^^^^^^^^^^^^ function[defaultLibrary]

            add : if (depth < 2) first else second;
                      ^^^^^ variable

            dec : case (depth & 7)
                        ^^^^^ variable

                0 : add;

                1, 2 : dec;

                default : first;

            endcase;

            third : rand join first second;

            fourth(string s = "done") : { if (depth) break; };
                          ^ parameter[declaration]
                                              ^^^^^ variable

        endsequence

    end

endmodule



